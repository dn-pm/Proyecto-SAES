-- ============ 6. INSCRIPCIONES a grupos (10) ============
-- Se buscan los ids por nombre de grupo y matricula, asi no importa que ids tengan.
INSERT IGNORE INTO grupo_alumno (ID_GRUPOS, ID_ALUMNOS, ESTATUS)
SELECT g.ID_GRUPOS, a.ID_ALUMNOS, t.estatus
FROM (
    SELECT 'TIC-101' AS grupo, 'TIC2026001' AS mat, 'ALTA' AS estatus
    UNION ALL SELECT 'TIC-101', 'TIC2026002', 'ALTA'
    UNION ALL SELECT 'TIC-101', 'TIC2026003', 'ALTA'
    UNION ALL SELECT 'TIC-102', 'TIC2026004', 'ALTA'
    UNION ALL SELECT 'TIC-102', 'TIC2026005', 'ALTA'
    UNION ALL SELECT 'TIC-201', 'TIC2026006', 'ALTA'
    UNION ALL SELECT 'TIC-201', 'TIC2026007', 'ALTA'
    UNION ALL SELECT 'TIC-202', 'TIC2026008', 'BAJA'
    UNION ALL SELECT 'TIC-301', 'TIC2026009', 'ALTA'
    UNION ALL SELECT 'TIC-301', 'TIC2026010', 'BAJA'
) t
JOIN grupos g  ON g.NOMBRE_GRUPO = t.grupo
JOIN alumnos a ON a.MATRICULA    = t.mat;

-- ============ 7. ASIGNACION de materias (10) ============
INSERT IGNORE INTO asignatura (ID_MATERIAS, ID_ALUMNOS, ID_PROFESORES)
SELECT m.ID_MATERIAS, a.ID_ALUMNOS, p.ID_PROFESORES
FROM (
    SELECT 'MAT-001' AS materia, 'TIC2026001' AS mat, 'PROF001' AS prof
    UNION ALL SELECT 'MAT-002', 'TIC2026001', 'PROF002'
    UNION ALL SELECT 'MAT-001', 'TIC2026002', 'PROF001'
    UNION ALL SELECT 'MAT-003', 'TIC2026002', 'PROF003'
    UNION ALL SELECT 'MAT-002', 'TIC2026003', 'PROF002'
    UNION ALL SELECT 'MAT-004', 'TIC2026004', 'PROF004'
    UNION ALL SELECT 'MAT-005', 'TIC2026005', 'PROF005'
    UNION ALL SELECT 'MAT-006', 'TIC2026006', 'PROF006'
    UNION ALL SELECT 'MAT-007', 'TIC2026007', 'PROF007'
    UNION ALL SELECT 'MAT-008', 'TIC2026008', 'PROF008'
) t
JOIN materias m   ON m.CLAVE_MATERIA = t.materia
JOIN alumnos a    ON a.MATRICULA     = t.mat
JOIN profesores p ON p.CLAVE         = t.prof;

-- ============ 8. CALIFICACIONES (10) ============
-- Solo unidades 1 y 2 y alumnos 1 a 5. Las unidades 3 a 10 y los alumnos 6 a 10
-- quedan libres para probar la captura individual y masiva en la pagina.
INSERT IGNORE INTO calificaciones (ID_ALUMNOS, CALIFICACION, ID_UNIDAD)
SELECT a.ID_ALUMNOS, t.cal, t.unidad
FROM (
    SELECT 'TIC2026001' AS mat, 9.5 AS cal, 1 AS unidad
    UNION ALL SELECT 'TIC2026002', 8.0, 1
    UNION ALL SELECT 'TIC2026003', 7.5, 1
    UNION ALL SELECT 'TIC2026004', 10.0, 1
    UNION ALL SELECT 'TIC2026005', 6.0, 1
    UNION ALL SELECT 'TIC2026001', 9.0, 2
    UNION ALL SELECT 'TIC2026002', 8.5, 2
    UNION ALL SELECT 'TIC2026003', 7.0, 2
    UNION ALL SELECT 'TIC2026004', 9.5, 2
    UNION ALL SELECT 'TIC2026005', 6.5, 2
) t
JOIN alumnos a ON a.MATRICULA = t.mat;
